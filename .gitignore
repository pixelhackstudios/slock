# Godot's editor cache (rebuilt automatically when the project opens)
/.godot/

# Game builds
/[Bb]uilds/

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
__pycache__/

# Source-art zip downloads (the extracted folders are kept)
/art-work/*.zip
/art-work/downloaded-attrbutions/*.zip

# Blender auto-backups
*.blend1

# Music masters (the game plays the .ogg copies in sounds/)
/art-work/music/
