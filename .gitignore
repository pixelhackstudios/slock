# Godot's editor cache (rebuilt automatically when the project opens)
/.godot/

# Game builds
/[Bb]uilds/

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
__pycache__/

# Source-art zip downloads (the extracted folders are kept)
/art-work/*.zip
/art-work/downloaded-attrbutions/*.zip

# Sounds left over from the Unity version, kept locally for reference (the ones the game uses are in sounds/)
/art-work/unity-sounds/

# Blender auto-backups
*.blend1
